R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=DNSSVC
VERSION=0.1.8
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ZIG_MODULE=dns_address_codec:src/address_codec.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/DNSSVC.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query2:2
IMPORT=R4NET:Query2:2
META=service.name=DNSSVC
META=service.args=/RUN
META=service.start=auto
META=service.enabled=yes
META=service.config=Injection\R4OS\CONFIG\SERVICES.R4S
